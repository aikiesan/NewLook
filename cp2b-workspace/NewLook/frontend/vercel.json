{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/((?!api|_next/static|_next/image|favicon.ico).*)",
      "dest": "/",
      "continue": true
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://new-look-delta.vercel.app"
  }
}

